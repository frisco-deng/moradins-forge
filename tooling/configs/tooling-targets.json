{
  "schema_version": 1,
  "repo": {
    "repo_id": "moradins-forge",
    "path": "projects/moradins-forge",
    "archetype": "uv-harness",
    "scan_tier": "hardened",
    "containerized": false,
    "default_branch": "main",
    "git_policy_profile": "main-only",
    "github_flow_profile": "free-public",
    "integration_branch": "",
    "production_branch": "",
    "dockerfiles": [],
    "compose_files": [],
    "npm_directories": [
      "dev_tracker/ui"
    ],
    "bootstrap": {
      "ci": {
        "commands": [
          "uv sync --group dev"
        ],
        "tools": []
      },
      "security": {
        "commands": [
          "uv sync --group dev"
        ],
        "tools": [
          "gitleaks",
          "trivy",
          "actionlint",
          "zizmor",
          "conftest",
          "yamllint",
          "semgrep",
          "pip-audit",
          "syft",
          "grype",
          "osv-scanner"
        ]
      },
      "container": {
        "commands": [
          "uv sync --group dev"
        ],
        "tools": [
          "gitleaks",
          "trivy",
          "actionlint",
          "zizmor",
          "conftest",
          "yamllint",
          "semgrep",
          "pip-audit",
          "syft",
          "grype",
          "osv-scanner"
        ]
      }
    },
    "python_runtime": {
      "detected": true,
      "manager": "uv",
      "source": "repo_files_or_commands",
      "markers": [
        ".venv/bin/python",
        "pyproject.toml",
        "uv.lock"
      ],
      "preferred_python_command": "uv run python",
      "notebook_inspection_command": "uv run python",
      "test_command": "uv run pytest",
      "fallback_python_command": "python3",
      "raw_python_allowed": false,
      "python3_valid_for_repo": false,
      "preferred_available": true,
      "uv_available": true,
      "python3_available": true,
      "raw_python_available": false,
      "route_note": "uv project detected; use uv so dependencies and project settings are active"
    },
    "ui_cli": {
      "enabled": true,
      "mode": "headless",
      "commands": [
        "npm --prefix dev_tracker/ui run test"
      ]
    },
    "ui_review": {
      "enabled": false,
      "targets": [],
      "commands": {},
      "summary": "artifacts/ui-review/latest/summary.md",
      "screenshots": "artifacts/ui-review/latest/screenshots",
      "lighthouse": "artifacts/ui-review/latest/lighthouse",
      "review_schema": [
        "screenshot_inventory",
        "viewport_state_coverage",
        "visual_issue_inventory",
        "component_semantics",
        "absence_checks",
        "before_after_expectation",
        "next_diagnostic",
        "full_log_path"
      ]
    },
    "ui_visual": {
      "enabled": false,
      "targets": [],
      "commands": {},
      "reference_manifest": "artifacts/ui-reference-renders/latest/manifest.json",
      "reference_image": "artifacts/ui-reference-renders/latest/reference.png",
      "measure_summary": "artifacts/ui-visual-measure/latest/summary.json",
      "measurements": "artifacts/ui-visual-measure/latest/measurements.csv"
    },
    "release": {
      "platforms": [],
      "targets": [],
      "windows_native_proof_classes": [],
      "manifest": "artifacts/release-candidate/latest/manifest.json",
      "summary": "artifacts/release-candidate/latest/summary.json"
    }
  },
  "targets": {
    "repo-brief": {
      "kind": "brief",
      "steps": [
        {
          "name": "brief-check-01",
          "required": false,
          "category": "brief-check",
          "command": "make forge-explain"
        }
      ]
    },
    "bootstrap-ci": {
      "kind": "commands",
      "steps": [
        {
          "name": "bootstrap-ci",
          "required": true,
          "category": "bootstrap",
          "command": "python3 tooling/bin/bootstrap_env.py bootstrap-ci"
        }
      ]
    },
    "bootstrap-security": {
      "kind": "commands",
      "steps": [
        {
          "name": "bootstrap-security",
          "required": true,
          "category": "bootstrap",
          "command": "python3 tooling/bin/bootstrap_env.py bootstrap-security"
        }
      ]
    },
    "verify-paths": {
      "kind": "commands",
      "steps": [
        {
          "name": "verify-paths",
          "required": true,
          "category": "path-hygiene",
          "command": "python3 tooling/bin/repo_path_hygiene.py --check --refresh-report --strict-origin --strict-mode public_candidate"
        }
      ]
    },
    "fix-paths-safe": {
      "kind": "commands",
      "steps": [
        {
          "name": "fix-paths-safe",
          "required": false,
          "category": "path-hygiene",
          "command": "python3 tooling/bin/repo_path_hygiene.py --rewrite-safe --refresh-report"
        }
      ]
    },
    "verify-fast": {
      "kind": "commands",
      "steps": [
        {
          "name": "verify-fast-01",
          "required": true,
          "category": "verify-fast",
          "command": "make test"
        },
        {
          "name": "verify-fast-02",
          "required": true,
          "category": "verify-fast",
          "command": "make payload-validate"
        }
      ]
    },
    "verify": {
      "kind": "commands",
      "steps": [
        {
          "name": "verify-01",
          "required": true,
          "category": "verify",
          "command": "make payload-smoke"
        },
        {
          "name": "verify-02",
          "required": true,
          "category": "verify",
          "command": "make forge-smoke"
        }
      ]
    },
    "verify-security": {
      "kind": "commands",
      "steps": [
        {
          "name": "repo-security-01",
          "required": true,
          "category": "repo-security",
          "command": "npm --prefix dev_tracker/ui audit --audit-level=moderate"
        },
        {
          "name": "gitleaks",
          "required": true,
          "category": "secret-scan",
          "command": "gitleaks detect --no-git --no-banner --redact --max-target-megabytes 10 --report-format json --report-path \"{artifact_root}/gitleaks.json\" --config tooling/configs/gitleaks/gitleaks.toml --source .",
          "tool": "gitleaks"
        },
        {
          "name": "trivy-fs",
          "required": true,
          "category": "security-scan",
          "command": "trivy fs --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed --scanners vuln,secret,misconfig,license --skip-dirs artifacts --skip-dirs archive --skip-dirs _archive --skip-dirs .data --skip-dirs outputs --skip-dirs packs --skip-dirs node_modules --skip-dirs .venv --skip-dirs .pytest_cache --skip-dirs .ruff_cache --skip-dirs .mypy_cache --skip-dirs .nox --skip-dirs .tox --skip-dirs .uv-cache --skip-dirs dist --skip-dirs build --skip-dirs coverage .",
          "tool": "trivy"
        },
        {
          "name": "workflow-actionlint",
          "required": true,
          "category": "workflow",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then actionlint .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then actionlint .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "actionlint"
        },
        {
          "name": "workflow-zizmor",
          "required": true,
          "category": "workflow",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then zizmor .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then zizmor .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "zizmor"
        },
        {
          "name": "workflow-conftest",
          "required": true,
          "category": "workflow",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then conftest test --all-namespaces -p tooling/policies/conftest/github-actions .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then conftest test --all-namespaces -p tooling/policies/conftest/github-actions .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "conftest"
        },
        {
          "name": "workflow-yamllint",
          "required": true,
          "category": "workflow",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then yamllint -c tooling/configs/yamllint/yamllint.yaml .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then yamllint -c tooling/configs/yamllint/yamllint.yaml .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "yamllint"
        },
        {
          "name": "semgrep",
          "required": false,
          "category": "security-scan",
          "command": "semgrep scan --config auto --error --exclude artifacts --exclude archive --exclude _archive --exclude .data --exclude outputs --exclude packs --exclude node_modules --exclude .venv --exclude .pytest_cache --exclude .ruff_cache --exclude .mypy_cache --exclude .nox --exclude .tox --exclude build --exclude dist --exclude coverage .",
          "tool": "semgrep"
        },
        {
          "name": "pip-audit",
          "required": false,
          "category": "dependency-scan",
          "command": "if [ -f pyproject.toml ]; then uv export --format requirements-txt --no-hashes > \"{artifact_root}/python-requirements.txt\" && pip-audit -r \"{artifact_root}/python-requirements.txt\" --no-deps --disable-pip; else echo \"python dependency audit not applicable\"; fi",
          "tool": "pip-audit"
        },
        {
          "name": "syft",
          "required": true,
          "category": "sbom",
          "command": "syft dir:. --exclude './artifacts/**' --exclude '**/artifacts/**' --exclude './archive/**' --exclude '**/archive/**' --exclude './_archive/**' --exclude '**/_archive/**' --exclude './.data/**' --exclude '**/.data/**' --exclude './outputs/**' --exclude '**/outputs/**' --exclude './packs/**' --exclude '**/packs/**' --exclude './node_modules/**' --exclude '**/node_modules/**' --exclude './.venv/**' --exclude '**/.venv/**' --exclude './.pytest_cache/**' --exclude '**/.pytest_cache/**' --exclude './.ruff_cache/**' --exclude '**/.ruff_cache/**' --exclude './.mypy_cache/**' --exclude '**/.mypy_cache/**' --exclude './.nox/**' --exclude '**/.nox/**' --exclude './.tox/**' --exclude '**/.tox/**' --exclude './.uv-cache/**' --exclude '**/.uv-cache/**' --exclude './dist/**' --exclude '**/dist/**' --exclude './build/**' --exclude '**/build/**' --exclude './coverage/**' --exclude '**/coverage/**' -o json > \"{artifact_root}/syft-sbom.json\"",
          "tool": "syft"
        },
        {
          "name": "grype",
          "required": true,
          "category": "security-scan",
          "command": "grype dir:. --exclude './artifacts/**' --exclude '**/artifacts/**' --exclude './archive/**' --exclude '**/archive/**' --exclude './_archive/**' --exclude '**/_archive/**' --exclude './.data/**' --exclude '**/.data/**' --exclude './outputs/**' --exclude '**/outputs/**' --exclude './packs/**' --exclude '**/packs/**' --exclude './node_modules/**' --exclude '**/node_modules/**' --exclude './.venv/**' --exclude '**/.venv/**' --exclude './.pytest_cache/**' --exclude '**/.pytest_cache/**' --exclude './.ruff_cache/**' --exclude '**/.ruff_cache/**' --exclude './.mypy_cache/**' --exclude '**/.mypy_cache/**' --exclude './.nox/**' --exclude '**/.nox/**' --exclude './.tox/**' --exclude '**/.tox/**' --exclude './.uv-cache/**' --exclude '**/.uv-cache/**' --exclude './dist/**' --exclude '**/dist/**' --exclude './build/**' --exclude '**/build/**' --exclude './coverage/**' --exclude '**/coverage/**' --fail-on high",
          "tool": "grype"
        },
        {
          "name": "osv-scanner",
          "required": false,
          "category": "dependency-scan",
          "command": "osv-scanner scan source -r . --format json > \"{artifact_root}/osv-scanner.json\"",
          "tool": "osv-scanner"
        }
      ]
    },
    "verify-ui-cli": {
      "kind": "commands",
      "steps": [
        {
          "name": "verify-ui-cli-01",
          "required": true,
          "category": "ui-cli",
          "command": "CI=1 npm --prefix dev_tracker/ui run test"
        }
      ]
    },
    "forge-explain": {
      "kind": "commands",
      "steps": [
        {
          "name": "forge-explain-01",
          "required": true,
          "category": "repo-native brief/status",
          "command": "make forge-explain"
        }
      ]
    },
    "payload-validate": {
      "kind": "commands",
      "steps": [
        {
          "name": "payload-validate-01",
          "required": true,
          "category": "payload-validation",
          "command": "make payload-validate"
        }
      ]
    },
    "payload-smoke": {
      "kind": "commands",
      "steps": [
        {
          "name": "payload-smoke-01",
          "required": true,
          "category": "payload-smoke",
          "command": "make payload-smoke"
        }
      ]
    },
    "forge-smoke": {
      "kind": "commands",
      "steps": [
        {
          "name": "forge-smoke-01",
          "required": true,
          "category": "forge-smoke",
          "command": "make forge-smoke"
        }
      ]
    },
    "public-portability-check": {
      "kind": "commands",
      "steps": [
        {
          "name": "public-portability-check-01",
          "required": true,
          "category": "public-portability",
          "command": "make public-portability-check"
        }
      ]
    },
    "review-ready": {
      "kind": "review-ready",
      "prep_steps": [],
      "core_targets": [
        "repo-brief",
        "verify-paths",
        "verify-fast",
        "verify",
        "verify-security"
      ],
      "full_targets": [
        "repo-brief",
        "verify-paths",
        "verify-fast",
        "verify",
        "verify-security",
        "verify-ui-cli",
        "ci-local"
      ],
      "advisory_targets": [
        "ci-local"
      ]
    },
    "verify-ci": {
      "kind": "commands",
      "steps": [
        {
          "name": "verify-paths",
          "required": true,
          "category": "path-hygiene",
          "command": "python3 tooling/bin/repo_path_hygiene.py --check --refresh-report --strict-origin --strict-mode public_candidate"
        },
        {
          "name": "verify-ci-01",
          "required": true,
          "category": "verify-ci",
          "command": "make public-portability-check"
        },
        {
          "name": "verify-ci-02",
          "required": true,
          "category": "verify-ci",
          "command": "make lint-py"
        },
        {
          "name": "verify-ci-03",
          "required": true,
          "category": "verify-ci",
          "command": "make lint-md"
        },
        {
          "name": "verify-ci-04",
          "required": true,
          "category": "verify-ci",
          "command": "npm --prefix dev_tracker/ui run test"
        },
        {
          "name": "verify-ci-05",
          "required": true,
          "category": "verify-ci",
          "command": "npm --prefix dev_tracker/ui run build"
        }
      ]
    },
    "ci-local": {
      "kind": "ci-local"
    }
  }
}
